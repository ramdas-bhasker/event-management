# ==============================================================================
# AyojanSetu – Next.js + Cloudflare Environment Variables Template
# Copy this file to .env.local for local development or configure in Vercel.
# ==============================================================================

# Public Frontend Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Hyderabad

# Future Cloudflare Workers API Endpoint (Leave empty until Cloudflare Worker is deployed)
NEXT_PUBLIC_CLOUDFLARE_API_URL=

# Future Cloudflare R2 Public Asset Base URL (For vendor portfolio & gallery media)
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=

# Future Cloudflare Turnstile Site Key (Public client-side spam protection key)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
